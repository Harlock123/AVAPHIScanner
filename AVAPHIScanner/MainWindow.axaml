<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lawgrid="clr-namespace:LAWgrid;assembly=LAWgrid"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="AVAPHIScanner.MainWindow"
        Title="AVA PHI Scanner"
        Width="1320" Height="820">

    <DockPanel>
    <Menu DockPanel.Dock="Top">
        <MenuItem Header="_File">
            <MenuItem Header="_New Project" InputGesture="Ctrl+N" Click="OnNewClick" />
            <MenuItem Header="_Open Project..." InputGesture="Ctrl+O" Click="OnOpenClick" />
            <MenuItem Header="_Save Project" InputGesture="Ctrl+S" Click="OnSaveClick" />
            <MenuItem Header="Save Project _As..." Click="OnSaveAsClick" />
            <Separator />
            <MenuItem Header="Add _Files..." Click="OnAddFileClick" />
            <MenuItem Header="Add F_older..." Click="OnAddFolderClick" />
            <MenuItem Header="Add _Database..." Click="OnAddDatabaseClick" />
            <Separator />
            <MenuItem Header="_Export Report..." Click="OnExportClick" />
        </MenuItem>
        <MenuItem Header="_Edit">
            <MenuItem x:Name="UndoMenuItem" Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClick" />
            <MenuItem x:Name="RedoMenuItem" Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedoClick" />
        </MenuItem>
        <MenuItem Header="_Scan">
            <MenuItem Header="_Scan Now" InputGesture="F5" Click="OnScanClick" />
            <MenuItem Header="Sample _Rows..." Click="OnSampleRowsClick" />
        </MenuItem>
        <MenuItem Header="_De-identify">
            <MenuItem Header="_De-identify..." Click="OnDeidentifyClick" />
            <MenuItem Header="_Verify a Copy..." Click="OnVerifyClick" />
        </MenuItem>
        <MenuItem Header="_AI">
            <MenuItem x:Name="ChatMenuItem" Header="AI _Chat" InputGesture="F12" ToggleType="CheckBox" Click="OnToggleChatClick" />
            <Separator />
            <MenuItem Header="_Database Connections..." Click="OnConnectionsClick" />
            <Separator />
            <MenuItem x:Name="AllowAgentsMenuItem" Header="_Allow AI Agents (MCP)" ToggleType="CheckBox" Click="OnAllowAgentsClick" />
            <MenuItem Header="C_onnect an Agent..." Click="OnConnectAgentClick" />
            <MenuItem Header="_Working Folder..." Click="OnWorkingFolderClick" />
        </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,3" BorderBrush="Gray" BorderThickness="0,1,0,0">
        <TextBlock x:Name="txtStatusBar" Text="Add a file, a folder or a database, then scan (F5)." FontSize="12" />
    </Border>

    <!-- The AI Chat (F12, AI > AI Chat), made the first time it is shown: MainWindow.Agents.cs. -->
    <Border x:Name="ChatHolder" DockPanel.Dock="Right" Width="440" IsVisible="False"
            BorderBrush="Gray" BorderThickness="1,0,0,0" />
    <!-- Hidden: where render_view draws the inventory for agents (a control needs a window to take its look). -->
    <Panel x:Name="AgentStage" DockPanel.Dock="Right" Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False" />

    <Grid ColumnDefinitions="270,4,*">
        <!-- Left: the sources and the policy. -->
        <DockPanel Grid.Column="0" Margin="10">
            <TextBlock DockPanel.Dock="Top" Text="Sources" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <WrapPanel>
                    <Button x:Name="cmdAddFile" Content="Add Files" Click="OnAddFileClick" Margin="0,0,4,4" />
                    <Button x:Name="cmdAddFolder" Content="Add Folder" Click="OnAddFolderClick" Margin="0,0,4,4" />
                    <Button x:Name="cmdAddDatabase" Content="Add Database" Click="OnAddDatabaseClick" Margin="0,0,4,4" />
                    <Button x:Name="cmdRemoveSource" Content="Remove" Click="OnRemoveSourceClick" Margin="0,0,4,4" />
                </WrapPanel>
                <Button x:Name="cmdScan" Content="Scan (F5)" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnScanClick" />
                <Separator Margin="0,6" />
                <TextBlock Text="De-identification policy" FontWeight="SemiBold" />
                <ComboBox x:Name="cboPolicy" HorizontalAlignment="Stretch" SelectionChanged="OnPolicyChanged">
                    <ComboBoxItem Content="Safe Harbor" />
                    <ComboBoxItem Content="Limited Data Set" />
                    <ComboBoxItem Content="Custom (per-column actions)" />
                </ComboBox>
                <ComboBox x:Name="cboDates" HorizontalAlignment="Stretch" SelectionChanged="OnPolicyChanged">
                    <ComboBoxItem Content="Dates: year only" />
                    <ComboBoxItem Content="Dates: shifted per person" />
                </ComboBox>
                <TextBlock x:Name="txtPolicy" TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
                <Button x:Name="cmdDeidentify" Content="De-identify..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnDeidentifyClick" />
                <Button x:Name="cmdVerify" Content="Verify a Copy..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnVerifyClick" />
            </StackPanel>
            <ListBox x:Name="lstSources" />
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#22808080" />

        <Grid Grid.Column="2" RowDefinitions="*,Auto">
            <TabControl x:Name="tabs" Grid.Row="0" Margin="4,0,4,0">
                <TabItem x:Name="tabInventory" Header="Inventory">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="2,0,0,4">
                            <CheckBox x:Name="chkPhiOnly" Content="PHI only" IsChecked="True" IsCheckedChanged="OnPhiOnlyChanged" />
                            <TextBlock x:Name="txtSummary" VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                        <lawgrid:LAWgrid x:Name="InventoryGrid" GridTitle="Where the PHI is (values masked)" GridTitleBackground="#2F4F6F" GridTitleBrush="White" GridTitleFontSize="15"
                                         GridHeaderBackground="#E4E7EC" GridHeaderBrush="#1C1C1C" GridBackground="White"
                                         GridCellBrush="#1C1C1C" GridCellOutline="#D8DCE2" GreenBarMode="True" GreenBarColor1="White" GreenBarColor2="#F2F5F9"
                                         GridSelectedItemBrush="#CFE3F7" GridFontSize="12" GridHeaderFontSize="12" />
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="tabRisk" Header="Risk">
                    <ScrollViewer>
                        <SelectableTextBlock x:Name="txtRisk" TextWrapping="Wrap" Margin="8" FontSize="13" />
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="tabFindings" Header="Free-Text Findings">
                    <lawgrid:LAWgrid x:Name="FindingsGrid" GridTitle="Identifiers inside free text (masked)" GridTitleBackground="#2F4F6F" GridTitleBrush="White" GridTitleFontSize="15"
                                         GridHeaderBackground="#E4E7EC" GridHeaderBrush="#1C1C1C" GridBackground="White"
                                         GridCellBrush="#1C1C1C" GridCellOutline="#D8DCE2" GreenBarMode="True" GreenBarColor1="White" GreenBarColor2="#F2F5F9"
                                         GridSelectedItemBrush="#CFE3F7" GridFontSize="12" GridHeaderFontSize="12" />
                </TabItem>
                <TabItem x:Name="tabCopy" Header="De-identified Copy">
                    <ScrollViewer>
                        <SelectableTextBlock x:Name="txtCopy" TextWrapping="Wrap" Margin="8" FontSize="13" Text="No copy yet: De-identify... writes one, then checks it." />
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- The selected column: why the scan thinks what it does, and the person's decision. -->
            <Border Grid.Row="1" Margin="4" Padding="8" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="6">
                    <WrapPanel>
                        <TextBlock Text="Column" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,4" />
                        <ComboBox x:Name="cboColumn" MinWidth="360" MaxWidth="520" Margin="0,0,12,4" SelectionChanged="OnColumnChanged" />
                        <ComboBox x:Name="cboKind" MinWidth="190" Margin="0,0,6,4" />
                        <Button x:Name="cmdMarkPhi" Content="Mark as PHI" Margin="0,0,6,4" Click="OnMarkPhiClick" />
                        <Button x:Name="cmdNotPhi" Content="Not PHI" Margin="0,0,6,4" Click="OnNotPhiClick" />
                        <Button x:Name="cmdClearDecision" Content="Clear" Margin="0,0,12,4" Click="OnClearDecisionClick" />
                        <ComboBox x:Name="cboAction" MinWidth="170" Margin="0,0,0,4" SelectionChanged="OnActionChanged" />
                    </WrapPanel>
                    <TextBlock x:Name="txtColumn" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
